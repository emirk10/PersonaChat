{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "PythonApi": {
    "Url": "http://python_app:5000/chat"
  },
  "ReverseProxy": {
    "Routes": {
      "python-backend": {
        "ClusterId": "python-cluster",
        "Match": {
          "Path": "/send_message/{**catch-all}"
        }
      },
      "python-persona-backend": {
        "ClusterId": "python-cluster",
        "Match": {
          "Path": "/send_persona_message/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "python-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://python_app:5000"
          }
        }
      }
    }
  }
}